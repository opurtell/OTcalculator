{
  "name": "actas-ot-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Station Ledger — the ACTAS OT Calculator component library",
  "main": "./dist/actas-ot-ui.umd.cjs",
  "module": "./dist/actas-ot-ui.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/actas-ot-ui.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/actas-ot-ui.js",
      "require": "./dist/actas-ot-ui.umd.cjs"
    },
    "./styles.css": "./dist/actas-ot-ui.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
